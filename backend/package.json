{
  "name": "exchange-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run --exclude src/api.spec.ts --exclude src/db/settlement.spec.ts --exclude src/routes/order.e2e.spec.ts",
    "test:integration": "vitest run src/api.spec.ts src/db/settlement.spec.ts src/routes/order.e2e.spec.ts",
    "test:settlement": "vitest run src/db/settlement.spec.ts",
    "test:differential:stress": "tsx src/engine/orderbook.stress.ts",
    "test:recovery": "tsx src/recovery/recovery.stress.ts",
    "test:recovery:hostile": "tsx src/recovery/recovery.hostile.ts",
    "verify": "tsc --noEmit && npm run test && npm run test:differential:stress && npm run build",
    "verify:full": "npm run verify && npm run test:recovery && npm run test:recovery:hostile",
    "migrate": "tsx src/db/migrate.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "autocannon": "^8.0.0",
    "fast-check": "^4.9.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "vitest": "^4.1.11"
  }
}
